{
  "compilerOptions": {
    "target": "es2016",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/scss/*": ["./styles/*"],
      "@/types/*": ["./scripts/types/*"],
      "@/locales/*": ["./locales/*"],
      "@/core/*": ["./scripts/core/*"],
      "@/main/*": ["./scripts/main/*"],
      "@/lib/*": ["./scripts/lib/*"],
      "@/pages/*": ["./scripts/pages/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "removeComments": true,
    "types": ["node"]
  },
  "include": ["scripts/", "webpack*", "**.ts"],
  "exclude": ["templates/", "styles/"]
}
