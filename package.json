{
  "name": "ingetya",
  "version": "0.0.1",
  "description": "Undangan digital terjangkau dengan fitur sekebon buat kamu",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngetYa/IngetYa.git"
  },
  "keywords": [],
  "author": "HiccupsRaven <hiccusraven@devanka.id> (https://devanka.id/)",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/IngetYa/IngetYa/issues"
  },
  "homepage": "https://github.com/IngetYa/IngetYa#readme",
  "private": true,
  "imports": {
    "#controllers/*": "./dist/controllers/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#models/*": "./dist/models/*.js",
    "#types/*": "./dist/types/*.js",
    "#core/*": "./dist/core/*.js",
    "#main/*": "./dist/main/*.js",
    "#bot/*": "./dist/bot/*.js",
    "#lib/*": "./dist/lib/*.js",
    "#cfg": "./dist/cfg.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/express-ws": "^3.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "raw-loader": "^4.0.2",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-ws": "^5.0.2",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "webfont-awesome-pro": "7.3.2-wip.10"
  },
  "scripts": {
    "format": "prettier --write .",
    "check": "prettier --check .",
    "type-check": "tsc -p . --pretty --noEmit",
    "lint": "eslint --ext ts",
    "start": "node .",
    "dev": "nodemon",
    "dev:be": "nodemon",
    "dev:fe": "npx --node-options=\"--import tsx\" webpack --disable-interpret --config frontend/webpack.dev.ts",
    "build": "npm run build:fe && npm run build:be",
    "build:be": "rm -rf ./dist/* && tsc -p . --extendedDiagnostics",
    "build:fe": "npx --node-options=\"--import tsx\" webpack --disable-interpret --config frontend/webpack.prod.ts"
  }
}
